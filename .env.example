# Copy this file to .env and fill in your values
# Never commit .env to version control!


# Required: Free Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=AIza-your-key-here


# Optional: Your database connection string
# Leave empty to use the demo SQLite database
DATABASE_URL=

# Examples:
# PostgreSQL: postgresql://user:password@localhost:5432/mydb
# MySQL:      mysql+pymysql://user:password@localhost:3306/mydb
# SQLite:     sqlite:///./my_database.db
