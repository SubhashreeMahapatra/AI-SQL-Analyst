# Copy this file to .env and fill in your values
# Never commit .env to version control!

# Required: Your OpenAI API key
OPENAI_API_KEY=sk-your-key-here

# Optional: Default model (gpt-4o, gpt-4o-mini, gpt-4-turbo)
OPENAI_MODEL=gpt-4o

# Optional: Your database connection string
# Leave empty to use the demo SQLite database
DATABASE_URL=

# Examples:
# PostgreSQL: postgresql://user:password@localhost:5432/mydb
# MySQL:      mysql+pymysql://user:password@localhost:3306/mydb
# SQLite:     sqlite:///./my_database.db
